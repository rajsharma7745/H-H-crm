# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Postgres connection string.
# Matches docker-compose.yml if you run `docker compose up -d db`.
DATABASE_URL="postgresql://hhcrm:hhcrm_dev_password@localhost:5432/hhcrm?schema=public"

# Base URL of the app, used to build absolute links (e.g. password reset emails).
APP_URL="http://localhost:3000"

# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME="hhcrm_session"

# Seed data for the first Super Admin account (used by `npm run db:seed`).
# Change the password after first login.
SEED_SUPER_ADMIN_EMAIL="admin@hhagency.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
SEED_SUPER_ADMIN_FIRST_NAME="Super"
SEED_SUPER_ADMIN_LAST_NAME="Admin"
