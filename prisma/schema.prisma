// H&H CRM database schema
// Phase 1: authentication, RBAC and audit foundation.
// Phase 3: Client Management.
// Future modules (Leads, Tasks, Time, Files, etc.) will add their own models
// and reference User via foreign key — do not add them here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// A role is a named bundle of permissions. Stored as data (not a hardcoded
/// enum) so new roles can be introduced later via seed/admin tooling without
/// a schema migration.
model Role {
  id          String   @id @default(cuid())
  /// Stable machine key, e.g. "SUPER_ADMIN". Never shown to users directly.
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

/// A single grantable capability, e.g. "users.view" or "clients.create".
/// Future modules add rows here (via migration/seed) — the auth system
/// itself never needs to change to support a new permission key.
model Permission {
  id          String   @id @default(cuid())
  /// "<module>.<action>", e.g. "users.view"
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

/// Join table: which permissions a role grants.
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  email           String     @unique
  /// bcrypt hash — the plaintext password is never persisted or logged.
  passwordHash    String
  roleId          String
  profileImageUrl String?
  phone           String?
  jobTitle        String?
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]           @relation("AuditActor")
  auditLogsAsTarget   AuditLog[]           @relation("AuditTarget")
  clientsOwned        Client[]             @relation("ClientOwner")
  leadsAssigned       Lead[]               @relation("LeadAssignedRep")
  leadsCreated        Lead[]               @relation("LeadCreatedBy")
  followUpsAssigned   FollowUp[]           @relation("FollowUpAssignedRep")
  followUpsCreated    FollowUp[]           @relation("FollowUpCreatedBy")
  leadActivities      LeadActivity[]       @relation("LeadActivityCreatedBy")

  @@index([roleId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Sessions (database-backed so logout / expiry are real, not just client-side)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hash of the random session token stored in the httpOnly cookie.
  /// The raw token is never persisted — only its hash, so a DB leak alone
  /// cannot be used to forge sessions.
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Password reset
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hash of the token embedded in the reset link. Raw token is
  /// never stored, mirroring Session's handling.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Clients (Phase 3)
// ---------------------------------------------------------------------------

/// Mirrors the B2B/B2C distinction already used for Leads (master spec
/// Section 4), carried onto Client so a converted lead keeps its type.
enum ClientType {
  B2B
  B2C
}

/// Client lifecycle per the master spec's Client entity (Section 4) — not to
/// be confused with a Lead's pipeline stage. PROSPECT = not yet onboarded,
/// PAUSED = temporarily inactive, CHURNED = relationship ended.
enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  CHURNED
}

model Client {
  id                   String       @id @default(cuid())
  name                 String
  clientType           ClientType   @default(B2B)
  status               ClientStatus @default(PROSPECT)
  primaryContactName   String?
  primaryContactEmail  String?
  primaryContactPhone  String?
  website              String?
  industry             String?
  address              String?
  notes                String?
  /// Account manager / owning employee. Nullable — a client can exist
  /// unassigned — and SetNull so the client record survives if its owner's
  /// account is ever removed.
  ownerId              String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  owner User? @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit foundation (Phase 1: auth/security events. Phase 3 adds Client
// events — Client has no direct AuditLog relation since targetId is a User
// foreign key, so client events carry clientId in metadata instead.)
// ---------------------------------------------------------------------------

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_ROLE_CHANGED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_ACTIVATED
  CLIENT_DEACTIVATED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STAGE_CHANGED
  LEAD_ASSIGNED
  LEAD_DELETED
  FOLLOWUP_CREATED
  FOLLOWUP_UPDATED
  FOLLOWUP_COMPLETED
  FOLLOWUP_CANCELLED
  LEAD_ACTIVITY_CREATED
  LEAD_ACTIVITY_UPDATED
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  /// Who performed the action. Null when the actor can't be identified yet
  /// (e.g. a failed login against an email with no matching account).
  actorId   String?
  /// The user record the action was performed on, when different from the
  /// actor (e.g. an admin deactivating someone else).
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Leads (Phase 1 of the Lead Management System scope change — H&H CRM's
// original Client/Task/Time/Files modules are frozen; Leads is the active
// build). One unified model with a pipeline discriminator rather than two
// separate tables, so "All Leads" can list both pipelines without a union
// query. Pipeline-specific fields are nullable and only meaningful for their
// own pipeline; which LeadStage values are valid for which pipeline is
// enforced in the Zod validation layer (src/lib/validation.ts), not by the
// database — Postgres has no clean way to scope one enum column to a
// caller-chosen subset of its own values.
// ---------------------------------------------------------------------------

enum LeadPipeline {
  ADS
  WARM_APPROACH
}

enum LeadStage {
  // Ads pipeline
  COLD
  WARM
  HOT
  // Warm Approach pipeline
  PLAN_MEET
  PITCHED
  PROPOSAL_SENT
}

/// Warm Approach's "win/loss status". Null means undecided — there is no
/// explicit OPEN value because "not yet won or lost" is just the absence of
/// an outcome, not a state a caller ever sets.
enum LeadOutcome {
  WON
  LOST
}

model Lead {
  id          String       @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  pipeline    LeadPipeline
  stage       LeadStage
  source      String?
  notes       String?

  /// Owning sales rep. Nullable/SetNull, mirrors Client.owner — a lead
  /// survives if the user assigned to it is later removed.
  assignedRepId String?
  /// Who created the lead. Same nullability rationale as assignedRepId.
  createdById   String?

  // -- Ads pipeline fields (meaningful when pipeline = ADS) -----------------
  campaignName         String?
  adCreative           String?
  submittedAt          DateTime?
  initialContactStatus String?
  interestLevel        String?
  qualificationNotes   String?
  lastContactedAt      DateTime?
  immediateRequirement String?
  /// Percentage, 0-100. Bounds enforced in Zod, not the database.
  closingProbability   Int?
  meetingScheduled     Boolean   @default(false)

  // -- Warm Approach pipeline fields (meaningful when pipeline = WARM_APPROACH) --
  lastInteractionAt  DateTime?
  scheduledMeetingAt DateTime?
  followUpNotes      String?
  pitchedAt          DateTime?
  serviceDiscussed   String?
  feedback           String?
  nextAction         String?
  proposalAmount     Decimal?     @db.Decimal(12, 2)
  proposalDocUrl     String?
  proposalSentAt     DateTime?
  expectedCloseAt    DateTime?
  outcome            LeadOutcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedRep User? @relation("LeadAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  createdBy   User? @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  followUps  FollowUp[]
  activities LeadActivity[]

  @@index([pipeline])
  @@index([stage])
  @@index([assignedRepId])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Follow-ups (Phase 4). Lead-scoped tasks: "call Jordan back Thursday".
// ---------------------------------------------------------------------------

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

model FollowUp {
  id          String           @id @default(cuid())
  leadId      String
  title       String
  description String?
  type        FollowUpType     @default(CALL)
  dueAt       DateTime
  status      FollowUpStatus   @default(PENDING)
  priority    FollowUpPriority @default(MEDIUM)
  /// Who owes this follow-up. Nullable/SetNull like every other user
  /// reference, so a follow-up survives its assignee being removed.
  assignedRepId String?
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// Cascade — unlike the SetNull used for *user* references, a follow-up is
  /// an owned child of its lead and is meaningless without it. Deleting a
  /// lead (which is a real delete, not a soft one) takes its follow-ups too.
  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedRep User? @relation("FollowUpAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  createdBy   User? @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status])
  @@index([dueAt])
  @@index([assignedRepId])
}

// ---------------------------------------------------------------------------
// Lead activities (Phase 5). The *business* communication history — what was
// said, when, by whom. Deliberately separate from AuditLog, which remains the
// security/audit trail: this table is user-authored content the team reads and
// edits, AuditLog is an append-only record of privileged actions.
// ---------------------------------------------------------------------------

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  OTHER
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  type        LeadActivityType @default(NOTE)
  title       String
  description String?
  /// When the call/meeting/email actually happened, which is not necessarily
  /// when the row was created (createdAt covers that).
  activityAt  DateTime
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  /// Cascade for the same reason as FollowUp.lead — an activity is an owned
  /// child of its lead, meaningless once the lead is gone.
  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([activityAt])
}
